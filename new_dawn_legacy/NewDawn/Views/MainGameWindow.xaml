<Window x:Class="NewDawn.Views.MainGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewDawn.Views"
        mc:Ignorable="d"
        Title="NewDawn" Height="1080" Width="1920"
        WindowState="Maximized"
        Loaded="MainGameWindow_Loaded" Background="#FF614596"
        >
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Top bar -->
        <Border Grid.Row="1" Background="#FF5C39AB" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Player 1 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"  VerticalAlignment="Center" >
                    <TextBlock Text="Player 1" FontWeight="SemiBold" Margin="0,0,14,0" FontSize="24" Foreground="White"/>
                    <TextBlock Text="Fuel:" Margin="0,0,6,0" FontSize="21" Foreground="White"/>
                    <TextBlock x:Name="TxtP1Fuel" FontWeight="SemiBold" Width="40" FontSize="21" Foreground="White"/>
                    <TextBlock Text="Alloy:" Margin="14,0,6,0" FontSize="21" Foreground="White"/>
                    <TextBlock x:Name="TxtP1Alloy" FontWeight="SemiBold" Width="60" FontSize="21" Foreground="White"/>
                </StackPanel>

                <!-- Turn -->
                <Border Grid.Column="1" Background="#FF6770AD" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <StackPanel >
                        <TextBlock x:Name="TxtTurnHeader" Text="Turn:" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="21" Foreground="White"/>
                        <TextBlock x:Name="TxtTurnPlayer" Text="Player 1" HorizontalAlignment="Center" FontSize="18" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Player 2 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Player 2" FontWeight="SemiBold" Margin="0,0,14,0" FontSize="24" Foreground="White"/>
                    <TextBlock Text="Fuel:" Margin="0,0,6,0" FontSize="21" Foreground="White"/>
                    <TextBlock x:Name="TxtP2Fuel" FontWeight="SemiBold" Width="40" FontSize="21" Foreground="White"/>
                    <TextBlock Text="Alloy:" Margin="14,0,6,0" FontSize="21" Foreground="White"/>
                    <TextBlock x:Name="TxtP2Alloy" FontWeight="SemiBold" Width="60" FontSize="21" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Unit shop -->
            <Border Grid.Column="0" Background="#FF300048" CornerRadius="8" Padding="10">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Unit's list" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="White"/>
                    <ListBox x:Name="LstShopUnits"
                             Background="#FF675D8D"
                             BorderThickness="0"
                             SelectionChanged="LstShopUnits_SelectionChanged"/>
                    
                </DockPanel>
            </Border>
            
            <!-- Map area -->
            <Border Grid.Column="2" Background="#FF41204E" CornerRadius="8" Padding="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <Canvas x:Name="MapCanvas" Background="#FF6E4D82"/>
                </ScrollViewer>
            </Border>
        </Grid>
        <!-- Bottom bar -->
        <Border Grid.Row="3" Background="#2B2B2B" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Info -->
                <Border Grid.Column="0" Background="#FF632D8A" CornerRadius="8" Padding="8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Info" FontWeight="Bold" Margin="0,0,0,6" Foreground="White"/>
                        <TextBlock x:Name="TxtInfo" TextWrapping="Wrap" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Actions (mb we should dynamically create them)-->
                <Border Grid.Column="1" Background="#FFA557D4" CornerRadius="8" Padding="8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnMove" Content="Move" Width="90" Margin="0,0,10,0" Click="BtnMove_Click" Background="#FF1B4E3A" Foreground="Khaki"/>
                        <Button x:Name="BtnAttack" Content="Attack" Width="90" Margin="0,0,10,0" Click="BtnAttack_Click" Background="#FF4E201B" Foreground="Khaki"/>
                        <Button x:Name="BtnSpecial" Content="Special" Width="90" Margin="0,0,10,0" Click="BtnSpecail_Click" Background="#FF4B4E1B" Foreground="Khaki"/>
                        <Button x:Name="BtnCancel" Content="Cancel" Width="90" Click="BtnCancel_Click" Background="#FF4E1B4A" Foreground="Khaki"/>
                    </StackPanel>
                </Border>

                <!-- Next turn + Save/Load/Back -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <Button x:Name="BtnNextTurn"
                            Content="Next turn"
                            Background="#FF2D1B4E"
                            Padding="10,14"
                            Margin="0,0,0,8"
                            Click="BtnNextTurn_Click" Width="232" Foreground="Khaki"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnSave" Content="Save" Width="70" Margin="0,0,8,0" Click="BtnSave_Click" Background="#FF2D1B4E" Foreground="Khaki"/>
                        <Button x:Name="BtnLoad" Content="Load" Width="70" Margin="0,0,8,0" Click="BtnLoad_Click" Background="#FF2D1B4E" Foreground="Khaki"/>
                        <Button x:Name="BtnBack" Content="Home" Width="70" Click="BtnBack_Click" Background="#FF2D1B4E" Foreground="Khaki"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
