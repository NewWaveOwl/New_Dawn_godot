<Window x:Class="NewDawn.Views.SavesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewDawn.Views"
        mc:Ignorable="d"
        Title="Game Saves" Height="450" Width="800" Background="#FF423254">
      <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- List -->
        <ListView x:Name="LstSaves"
                  DisplayMemberPath="DisplayName"
                  Grid.Row="0"
                  MouseDoubleClick="LstSaves_MouseDoubleClick" Background="#FFDFD1EA">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name"
                                    Width="330"
                                    DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="Modified"
                                    Width="240"
                                    DisplayMemberBinding="{Binding Modified, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Load"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="BtnLoad_Click" Background="#FF2D1B4E" Foreground="Khaki"/>
            <Button Content="Close"
                    Width="90"
                    Click="BtnClose_Click" Background="#FF2D1B4E" Foreground="Khaki"/>
        </StackPanel>
    </Grid>
</Window>
