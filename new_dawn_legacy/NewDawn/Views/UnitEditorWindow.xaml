<Window x:Class="NewDawn.Views.UnitEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewDawn"
        Title="Unit Editor"
        Width="1920" Height="1080"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="White">

    <Grid Background="#FFDAA6FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#FF5C39AB" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Unit Editor" 
                          FontSize="20" 
                          FontWeight="SemiBold" 
                          VerticalAlignment="Center" 
                          Margin="20,0,0,0" Foreground="White"/>

                <Button Height="35" Width="60" 
                       HorizontalAlignment="Right" 
                       Margin="0,0,30,0"
                       Click="ButtonGoBack_Click" 
                       Background="#FF2D1B4E" 
                       BorderBrush="#AAAAAA"
                       BorderThickness="1" Foreground="Khaki">
                    <TextBlock Text="Home" FontSize="12" FontWeight="Bold"/>
                </Button>
            </Grid>
        </Border>

        <!-- DataGrid Table -->
        <Border Grid.Row="1" Margin="20" BorderBrush="#CCCCCC" BorderThickness="1">
            <DataGrid x:Name="UnitsDataGrid" 
                     AutoGenerateColumns="False" 
                     CanUserAddRows="False" 
                     CanUserDeleteRows="False"
                     HeadersVisibility="Column"
                     GridLinesVisibility="All"
                     AlternatingRowBackground="#F9F9F9"
                     RowHeaderWidth="0" Background="#FFD3CBEA">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Unit Name" Binding="{Binding Name}" Width="120" IsReadOnly="True"/>

                    <!-- HP -->
                    <DataGridTextColumn Header="Price" Binding="{Binding PriceAlloy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="80"/>
                    <DataGridTextColumn Header="HP" Binding="{Binding HP}" Width="60"/>
                    <DataGridTextColumn Header="DMG" Binding="{Binding Damage}" Width="60"/>
                    <DataGridTextColumn Header="Range"  Binding="{Binding Range}"  Width="60"/>
                    <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="60"/>
                    <DataGridCheckBoxColumn Header="Armored" Binding="{Binding Armored}" Width="80"/>

                    <DataGridComboBoxColumn Header="Special" Width="120" SelectedItemBinding="{Binding CoreType}">
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemsSource" Value="{Binding CoreTypes}"/>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemsSource" Value="{Binding CoreTypes}"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Background="#FF46288A" Margin="0">
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Center" 
                       Margin="0,0,20,0">

                <!-- Load Button -->
                <Button x:Name="BtnLoad" 
                       Click="BtnLoad_Click"
                       Width="100" 
                       Height="50" 
                       Margin="0,0,15,0"
                       Background="#FF2D1B4E"
                       BorderBrush="#888888"
                       BorderThickness="1" Foreground="Khaki">
                    <StackPanel>
                        <TextBlock Text="Load" 
                                  HorizontalAlignment="Center" 
                                  FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSave" 
                       Click="BtnSave_Click"
                       Width="100" 
                       Height="50"
                       Background="#FF2D1B4E"
                       BorderBrush="#888888"
                       BorderThickness="1" Foreground="Khaki">
                    <StackPanel>
                        <TextBlock Text="Save" 
                                  HorizontalAlignment="Center" 
                                  FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>